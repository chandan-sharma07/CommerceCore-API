# ── Application ──────────────────────────────────────────────────────────────

# Runtime environment: development | production | test
NODE_ENV=development

# HTTP port the Express server listens on
PORT=3000

# ── MySQL (Sequelize) ─────────────────────────────────────────────────────────

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=commerce_user
MYSQL_PASSWORD=commerce_pass

# Database name (use a different name for test: commercecore_test)
MYSQL_DATABASE=commercecore

# ── MongoDB (Mongoose) ────────────────────────────────────────────────────────

# Full connection URI — change DB name for test environment
MONGO_URI=mongodb://localhost:27017/commercecore

# ── Redis (ioredis) ───────────────────────────────────────────────────────────

# Redis URL — DB index 0 for dev, 1 for test (avoids cache collisions)
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────

# Access token secret — minimum 32 random characters, keep secret!
JWT_ACCESS_SECRET=your-access-secret-change-in-production-min-32-chars

# Refresh token secret — different from access secret, minimum 32 chars
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production-min-32-chars

# Access token lifetime (e.g. 15m, 1h)
JWT_ACCESS_EXPIRY=15m

# Refresh token lifetime (e.g. 7d, 30d)
JWT_REFRESH_EXPIRY=7d

# ── Logging ───────────────────────────────────────────────────────────────────

# Winston log level: error | warn | info | debug
# Use 'debug' in development, 'warn' or 'error' in production
LOG_LEVEL=debug

# ── CORS ─────────────────────────────────────────────────────────────────────

# Allowed origins for CORS.
# Development: * (all origins)
# Production:  set to your frontend domain, e.g. https://myapp.com
CORS_ORIGIN=*
